<svg viewBox="0 0 1200 630" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#06152A;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0A1F3D;stop-opacity:1" />
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="1200" height="630" fill="url(#bgGrad)"/>

  <!-- Left: Logo circle background -->
  <circle cx="220" cy="315" r="180" fill="rgba(193,154,91,0.08)" opacity="0.5"/>

  <!-- Logo circle border (outer) -->
  <circle cx="220" cy="315" r="160" fill="none" stroke="rgba(193,154,91,0.4)" stroke-width="2"/>
  <circle cx="220" cy="315" r="158" fill="none" stroke="rgba(193,154,91,0.2)" stroke-width="1"/>

  <!-- Logo circle border (inner) -->
  <circle cx="220" cy="315" r="145" fill="none" stroke="rgba(193,154,91,0.3)" stroke-width="1.5"/>

  <!-- ZERO text -->
  <text x="220" y="265" font-size="40" font-weight="700" fill="rgba(193,154,91,1)" text-anchor="middle" font-family="'Jost', serif" letter-spacing="3">
    ZERO
  </text>

  <!-- Large "60" with shadow effect -->
  <text x="220" y="330" font-size="110" font-weight="800" fill="rgba(100,100,120,0.15)" text-anchor="middle" font-family="'Jost', serif" letter-spacing="-2">
    60
  </text>
  <text x="218" y="328" font-size="110" font-weight="800" fill="rgba(193,154,91,1)" text-anchor="middle" font-family="'Jost', serif" letter-spacing="-2">
    60
  </text>

  <!-- VINCOLI text -->
  <text x="220" y="375" font-size="40" font-weight="700" fill="rgba(193,154,91,1)" text-anchor="middle" font-family="'Jost', serif" letter-spacing="2">
    VINCOLI
  </text>

  <!-- Right side: Main message -->
  <g>
    <!-- Main headline -->
    <text x="520" y="160" font-size="58" font-weight="800" fill="#ffffff" font-family="'Jost', serif" letter-spacing="-1">
      Zero Vincoli 60
    </text>

    <!-- Subheadline 1 -->
    <text x="520" y="240" font-size="36" font-weight="700" fill="rgba(193,154,91,1)" font-family="'Jost', serif">
      Vendi casa
    </text>

    <!-- Subheadline 2 -->
    <text x="520" y="290" font-size="36" font-weight="700" fill="rgba(193,154,91,1)" font-family="'Jost', serif">
      senza vincoli in 60 giorni
    </text>

    <!-- Tagline -->
    <text x="520" y="370" font-size="17" font-weight="500" fill="#a8b8c8" font-family="'Jost', sans-serif" letter-spacing="0.5">
      Mandato esclusivo · Nessuna penale
    </text>

    <!-- Trust line -->
    <text x="520" y="420" font-size="16" font-weight="600" fill="rgba(193,154,91,0.9)" font-family="'Jost', sans-serif" letter-spacing="0.3">
      ✓ FondoCasa Hub · Napoli
    </text>
  </g>

  <!-- Bottom decorative line -->
  <line x1="0" y1="580" x2="1200" y2="580" stroke="rgba(193,154,91,0.2)" stroke-width="2"/>
</svg>